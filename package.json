{
  "name": "claude-companion",
  "version": "0.29.0",
  "description": "Chat with Claude inside your Obsidian vault, generate beautiful interactive artifacts, and sync them back into your notes.",
  "main": "main.js",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cavi-ai/claude-obsidian.git",
    "directory": "obsidian-plugin"
  },
  "bugs": {
    "url": "https://github.com/cavi-ai/claude-obsidian/issues"
  },
  "homepage": "https://github.com/cavi-ai/claude-obsidian/tree/main/obsidian-plugin#readme",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "verify:build-output": "git diff --exit-code -- main.js manifest.json",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "verify:version": "node tools/verifyVersion.mjs",
    "lint": "eslint src",
    "audit": "pnpm dlx pnpm@11.7.0 --pm-on-fail=ignore audit --prod --audit-level high",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm run build && playwright test --config=e2e/playwright.config.ts",
    "test:e2e:research": "pnpm run build && playwright test --config=e2e/playwright.config.ts e2e/research-desk.spec.ts",
    "docs:build": "node tools/build-docs-artifact.mjs",
    "docs:verify": "node tools/docs-check.mjs",
    "bundle:report": "node tools/bundle-report.mjs",
    "bundle:check": "node tools/bundle-report.mjs --check",
    "skills:build": "node tools/build-skill-registry.mjs",
    "skills:verify": "node tools/verify-skill-registry.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "claude",
    "anthropic",
    "ai"
  ],
  "license": "MIT",
  "devDependencies": {
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@types/node": "^26.4.1",
    "esbuild": "0.28.2",
    "eslint": "^10.10.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.12.0",
    "linkedom": "^0.18.13",
    "obsidian": "^1.13.0",
    "tslib": "^2.6.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "defuddle": "^0.19.3",
    "pdfjs-dist": "~6.2.108"
  }
}
